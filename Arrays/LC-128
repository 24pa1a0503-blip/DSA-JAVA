class Solution {
    public int longestConsecutive(int[] nums) {
        if(nums==null || nums.length==0) return 0;
        Arrays.sort(nums);
        int c=0;
        int ans=0;
        for(int i=1;i<nums.length;i++){
            if(nums[i]-nums[i-1]==0) continue;
            else if(nums[i]-nums[i-1]==1){
                c++;
                ans=Math.max(ans,c);
            }
            else{
                c=0;
            }
        }
        return ans+1;
    }
}
