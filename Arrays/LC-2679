class Solution {
    public int matrixSum(int[][] nums) {
        int s=0;
        int n=nums.length;
        int m=nums[0].length;
        for(int i=0;i<n;i++){
            Arrays.sort(nums[i]);
        }
        for(int i=0;i<m;i++){
            int max=Integer.MIN_VALUE;
            for(int j=0;j<n;j++){
                if(nums[j][i]>max) max=nums[j][i];
            }
            s+=max;
        }
        return s;
    }
}
