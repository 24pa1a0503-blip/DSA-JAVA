class Solution {
    static int square(int n){
        return (int)Math.pow(n,2);
    }
    public int sumOfSquares(int[] nums) {
        int s=0;
        int n=nums.length;
        for(int i=0;i<n;i++){
            if(n%(i+1)==0){
                s+=square(nums[i]);
            }
        }
        return s;
    }
}
