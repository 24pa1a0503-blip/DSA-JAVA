class Solution {
    public int[] numberGame(int[] nums) {
        int n=nums.length;
        List<Integer> lst=new ArrayList<>();
        int[] a=new int[n];
        Arrays.sort(nums);
        for(int i=0;i<n-1;i+=2){
            int al=nums[i];
            int b=nums[i+1];
            lst.add(b);
            lst.add(al);
        }
        for(int i=0;i<n;i++){
            a[i]=lst.get(i);
        }
        return a;
    }
}
