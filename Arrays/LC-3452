class Solution {
    public int sumOfGoodNumbers(int[] nums, int k) {
        int n=nums.length;
        int s=0;
        for(int i=0;i<n;i++){
           boolean f=true;
           if(i-k>=0){
            if(nums[i]<=nums[i-k]) f=false;
           }
           if(i+k<n){
            if(nums[i]<=nums[i+k]) f=false;
           }
           if(f) s+=nums[i];
        }
        return s;
    }
}
