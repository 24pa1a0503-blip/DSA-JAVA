class Solution {
    public int firstStableIndex(int[] nums, int k) {
        int n=nums.length;
        int[] sm=new int[n];
        sm[n-1]=nums[n-1];
        for(int i=n-2;i>=0;i--){
            sm[i]=Math.min(nums[i],sm[i+1]);
        }
        int pm=Integer.MIN_VALUE;
        for(int i=0;i<n;i++){
            pm=Math.max(pm,nums[i]);
            int sc=pm-sm[i];
            if(sc<=k) return i;
        }
        return -1;
    }
}
