class Solution {
    public int nearestDrone(int[][] drones, int[] target) {
        int min=Integer.MAX_VALUE;
        int x=target[0];
        int y=target[1];
        int idx=-1;
        for(int i=0;i<drones.length;i++){
            int dis=Math.abs(drones[i][0]-x)+Math.abs(drones[i][1]-y);
            if(dis<=drones[i][2]){
                if(dis<min){
                    min=dis;
                    idx=i;
                }
            }
        }
        return idx;
    }
}
