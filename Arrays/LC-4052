class Solution {
    public int[][] cyclicShift(int n, int[][] grid, int[] row, int[] col) {
        int[][] ans=new int[n][n];
        for(int i=0;i<n;i++){
            int k=row[i]%n;
            for(int j=0;j<n;j++){
                int nj=(j-k+n)%n;
                ans[i][nj]=grid[i][j];
            }
        }
        int[][] fans=new int[n][n];
        for(int i=0;i<n;i++){
             int k=col[i]%n;
            for(int j=0;j<n;j++){
                int ni=(j-k+n)%n;
                fans[ni][i]=ans[j][i];
            }
        }
        return fans;
    }
}
