class Solution {
    static long help(int n){
        char[] dig=String.valueOf(n).toCharArray();
        Arrays.sort(dig);
        long res=0;
        for(int i=dig.length-1;i>=0;i--) res=res*10+(dig[i]-'0');
        return res;
    }
    public long maximizeSum(int[] nums, int k) {
        long s=0;
        long[] g=new long[nums.length];
        for(int i=0;i<nums.length;i++){
            s+=nums[i];
            g[i]=help(nums[i])-nums[i];
        }
        Arrays.sort(g);
        for(int i=g.length-1;i>=0&&k>0;i--,k--) s+=g[i];
        return s;
    }
}
