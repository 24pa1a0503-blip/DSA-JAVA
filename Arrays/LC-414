class Solution {
    public int thirdMax(int[] nums) {
        HashSet<Integer> set=new HashSet<>();
        for(int i=0;i<nums.length;i++){
            set.add(nums[i]);
        }
        Integer[] arr=set.toArray(new Integer[0]);
        Arrays.sort(arr, Collections.reverseOrder());
        if(arr.length<3) return arr[0];
        else return arr[2];
    }
}
