class Solution {
    public List<Integer> findDuplicates(int[] nums) {
        int n=nums.length;
        List<Integer> lst=new ArrayList<>();
        for(int i=0;i<n;i++){
            int val=Math.abs(nums[i]);
            int tar=val-1;
            if(nums[tar]<0){
                lst.add(val);
            }
            else{
                nums[tar]=-nums[tar];
            }
        }
        return lst;
    }
}
