class Solution {
    public List<Integer> spiralOrder(int[][] matrix) {
        List<Integer> lst=new ArrayList<>();
        if(matrix.length==0) return lst;
        int m=matrix.length;
        int n=matrix[0].length;
        int top=0;
        int bottom=m-1;
        int left=0;
        int right=n-1;
        while(top<=bottom && left<=right){
            for(int j=left;j<=right;j++) lst.add(matrix[top][j]);
            top++;
            for(int i=top;i<=bottom;i++) lst.add(matrix[i][right]);
            right--;
            if(top<=bottom && left<=right){
                for(int j=right;j>=left;j--) lst.add(matrix[bottom][j]);
                bottom--;
                for(int i=bottom;i>=top;i--) lst.add(matrix[i][left]);
                left++;
            }
        }
        return lst;
    }
}
