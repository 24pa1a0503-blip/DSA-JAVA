class Solution {
    public int[][] flipAndInvertImage(int[][] image) {
        int n=image.length;
        int[][] res=new int[n][n];
        for(int i=0;i<n;i++){
            int pos=0;
            for(int j=n-1;j>=0;j--){
                res[i][pos++]=image[i][j];
            }
        }
        for(int i=0;i<n;i++){
            for(int j=0;j<n;j++){
                if(res[i][j]==0) res[i][j]=1;
                else res[i][j]=0;
            }
        }
        return res;
    }
}
