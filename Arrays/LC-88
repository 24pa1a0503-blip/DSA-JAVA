class Solution {
    public void merge(int[] nums1, int m, int[] nums2, int n) {
        int[] n1=new int[m];
        for(int i=0;i<m;i++){
            n1[i]=nums1[i];
        }
        int[] res=new int[m+n];
        int i=0,j=0,pos=0;
        while(i<m && j<n){
            if(n1[i]<=nums2[j]){
                res[pos++]=n1[i++];
            }
            else{
                res[pos++]=nums2[j++];
            }
        }
        while(i<m){
            res[pos++]=n1[i++];
        }
        while(j<n){
            res[pos++]=nums2[j++];
        }
        for(int x=0;x<res.length;x++){
            nums1[x]=res[x];
        }
    }
}
