class Solution {
    static boolean monIn(int[] nums,int i){
        int n=nums.length;
        for(int x=i;x<n-1;x++){
            if(nums[x]<nums[x+1]) return false;
        }
        return true;
    }
    static boolean monDe(int[] nums,int i){
        int n=nums.length;
        for(int y=i;y<n-1;y++){
            if(nums[y]>nums[y+1]) return false;
        }
        return true;
    }
    public boolean isMonotonic(int[] nums) {
        int n=nums.length;
        for(int i=0;i<n-1;i++){
            if(nums[i]==nums[i+1]) continue;
            else if(nums[i]>nums[i+1]) return monIn(nums,i);
            else if(nums[i]<nums[i+1]) return monDe(nums,i);
        }
        return true;
    }
}
