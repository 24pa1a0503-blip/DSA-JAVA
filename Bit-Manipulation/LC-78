class Solution {
    static int getKB(int n,int k){
        return (n>>k)&1;
    }
    public List<List<Integer>> subsets(int[] nums) {
        List<List<Integer>> ans=new ArrayList<>();
        int n=nums.length;
        for(int i=0;i<(1<<n);i++){
            List<Integer> res=new ArrayList<>();
            for(int j=0;j<n;j++){
                if(getKB(i,j)==1) res.add(nums[j]);
            }
            ans.add(res);
        }
        return ans;
    }
}
