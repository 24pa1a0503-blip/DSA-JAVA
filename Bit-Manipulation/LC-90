class Solution {
    static int getKB(int n,int k){
        return (n>>k)&1;
    }
    public List<List<Integer>> subsetsWithDup(int[] nums) {
        List<List<Integer>> ans=new ArrayList<>();
        int n=nums.length;
        Arrays.sort(nums);
        for(int i=0;i<(1<<n);i++){
            List<Integer> lst=new ArrayList();
            for(int j=0;j<n;j++){
                if(getKB(i,j)==1) lst.add(nums[j]);
            }
            if(!ans.contains(lst)) ans.add(lst);
            else continue;
        }
        return ans;
    }
}
