class Solution {
    public int longestConsecutive(int[] nums) {
        if(nums==null || nums.length==0){
            return 0;
        }
        HashSet<Integer> set=new HashSet<>();
        for(int x: nums){
            set.add(x);
        }
        int max=0;
        for(int num : set){
            if(!set.contains(num-1)){
                int cn=num;
                int cs=1;
                while(set.contains(cn+1)){
                    cn+=1;
                    cs+=1;
                }
                max=Math.max(max,cs);
            }
        }
        return max;
    }
}
