import java.util.*;

class Main{
	public static void main(String args[])
	{
		Scanner sc=new Scanner(System.in);
		int n1=sc.nextInt();
		int n2=sc.nextInt();
		int[] a1=new int[n1];
		int[] a2=new int[n2];
		for(int i=0;i<n1;i++){
			a1[i]=sc.nextInt();
		}
		for(int i=0;i<n2;i++){
			a2[i]=sc.nextInt();
		}
		int k=sc.nextInt();
		int c1=0,c2=0;
		for(int i=0;i<n1;i++){
			if(a1[i]>k) c1++;
		}
		for(int i=0;i<n2;i++){
			if(a2[i]<k) c2++;
		}
		if(c1>c2) System.out.println(c1);
		else System.out.println(c2);
	}
}
