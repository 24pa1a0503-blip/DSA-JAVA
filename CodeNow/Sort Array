import java.util.*;

class Main{
	public static void main(String args[])
	{
		Scanner sc=new Scanner(System.in);
		int n=sc.nextInt();
		int[] a=new int[n];
		for(int i=0;i<n;i++){
			a[i]=sc.nextInt();
		}
		Arrays.sort(a);
		int[] res=new int[n];
		for(int i=0;i<(n+1)/2;i++){
			res[i]=a[i];
		}
		int pos=(n+1)/2;
		for(int i=n-1;i>=(n+1)/2;i--){
			res[pos++]=a[i];
		}
		for(int i=0;i<n;i++){
			System.out.print(res[i]+" ");
		}
	}
}
