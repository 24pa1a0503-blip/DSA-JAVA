class Solution {
    public int[] twoSum(int[] nums, int target) {
        HashMap<Integer,Integer> map=new HashMap<>();
        for(int i=0;i<nums.length;i++){
            int rq=target-nums[i];
            if(map.containsKey(rq)){
                return new int[]{map.get(rq),i};
            }
            map.put(nums[i],i);
        }
        return new int[0];
    }
}
