class Solution {
    public char repeatedCharacter(String s) {
        int  n=s.length();
        HashMap<Character,Integer> map=new HashMap<>();
        for(int i=0;i<n;i++){
            char ch=s.charAt(i);
            map.put(ch,map.getOrDefault(ch,0)+1);
            if(map.get(s.charAt(i))==2){
                return s.charAt(i);
            }
        }
        return '\u0000';
    }
}
