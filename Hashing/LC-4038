class Solution {
    public int countSpecialIntegers(int[] nums) {
        HashSet<Integer> inv=new HashSet<>();
        HashSet<Integer> unq=new HashSet<>();
        for(int x: nums){
            unq.add(x);
        }
        HashSet<Integer> seen=new HashSet<>();
        for(int i=0;i<nums.length;i++){
            if(i>0 && nums[i]!=nums[i-1]) seen.add(nums[i-1]);
            if(seen.contains(nums[i])) inv.add(nums[i]);
        }
        return unq.size()-inv.size();
    }
}
