class Solution {
    public boolean squareIsWhite(String coordinates) {
        int col= (int) coordinates.charAt(0);
        int row=coordinates.charAt(1)-'0';
        if(col%2!=0){
            if(row%2==0) return true;
            else return false;
        }
        else{
            if(row%2!=0) return true;
            else return false;
        }
    }
}
