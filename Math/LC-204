class Solution { 
    public int countPrimes(int n) {
        if(n<2) return 0;
        boolean[] s=new boolean[n];
        int c=0;
        for(int i=2;i<n;i++){
            if(!s[i]){
                c++;
                for(long j=(long)i*i;j<n;j+=i) s[(int)j]=true;
            }
        }
        return c;
    }
}
