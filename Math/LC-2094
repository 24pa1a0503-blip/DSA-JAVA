class Solution {
    public int[] findEvenNumbers(int[] digits) {
        HashSet<Integer> lst=new HashSet<>();
        int n=digits.length;
        for(int i=0;i<n;i++){
            for(int j=0;j<n;j++){
                for(int k=0;k<n;k++){
                    if(i!=j && j!=k && k!=i){
                        if(digits[i]!=0){
                            if(digits[k]%2==0){
                                int num=digits[i]*100+digits[j]*10+digits[k];
                                lst.add(num); 
                            }
                        }
                    }
                }
            }
        }
        int s=lst.size();
        int[] ans=new int[s];
        int pos=0;
        for(int x: lst){
            ans[pos++]=x;
        }
        Arrays.sort(ans);
        return ans;
    }
}
