class Solution {
    public int divisorSubstrings(int num, int k) {
        String s=Integer.toString(num);
        int n=s.length();
        int c=0;
        for(int i=0;i<n-k+1;i++){
            String sub=s.substring(i,i+k);
            int val=Integer.parseInt(sub);
            if(val==0) continue;
            if(num%val==0) c++;
        }
        return c;
    }
}
