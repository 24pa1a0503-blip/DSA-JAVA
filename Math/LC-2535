class Solution {
    static int help(int n){
        int sum=0;
        while(n!=0){
            sum+=n%10;
            n=n/10;
        }
        return sum;
    }
    public int differenceOfSum(int[] nums) {
        int n=nums.length;
        int es=0,ds=0;
        for(int i=0;i<n;i++){
            es+=nums[i];
            ds+=help(nums[i]);
        }
        return Math.abs(es-ds);
    }
}
