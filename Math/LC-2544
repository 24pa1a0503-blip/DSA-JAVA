class Solution {
    public int alternateDigitSum(int n) {
        String s=Integer.toString(n);
        int[] val=new int[s.length()];
        for(int i=0;i<s.length();i++){
            int num=s.charAt(i)-'0';
            val[i]=num;
        }
        int sum=val[0];
        for(int i=1;i<val.length;i++){
            if(i%2==0) sum+=val[i];
            else sum+=(-1)*val[i];
        }
        return sum;
    }
}
