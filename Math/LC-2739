class Solution {
    public int distanceTraveled(int mainTank, int additionalTank) {
        int tot=0;
        while(mainTank>=5){
            tot=tot+5;
            mainTank=mainTank-5;
            if(additionalTank>0){
                mainTank=mainTank+1;
                additionalTank=additionalTank-1;
            }
        }
        tot+=mainTank;
        return tot*10;
    }
}
