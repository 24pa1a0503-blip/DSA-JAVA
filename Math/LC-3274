class Solution {
    public boolean checkTwoChessboards(String coordinate1, String coordinate2) {
        int col1=(int) coordinate1.charAt(0);
        int row1=coordinate1.charAt(1)-'0';
        int col2=(int) coordinate2.charAt(0);
        int row2=coordinate2.charAt(1)-'0';
        if(col1%2!=0 && col2%2!=0){
            if(row1%2!=0 && row2%2!=0) return true;
            else if(row1%2==0 && row2%2==0) return true;
            else return false;
        }
        else if(col1%2==0 && col2%2==0){
            if(row1%2!=0 && row2%2!=0) return true;
            else if(row1%2==0 && row2%2==0) return true;
            else return false;
        }
        else if(col1%2==0 && col2%2!=0){
            if(row1%2==0 && row2%2!=0) return true;
            else if(row1%2!=0 && row2%2==0) return true;
            else return false;
        }
        else if(col1%2!=0 && col2%2==0){
            if(row1%2!=0 && row2%2==0) return true;
            else if(row1%2==0 && row2%2!=0) return true;
            else return false;
        }
        else return false;
    }
}
