class Solution {
    static boolean isAns(int n,int t){
        int pr=1;
        while(n!=0){
            int r=n%10;
            pr*=r;
            n=n/10;
        }
        if(pr%t==0) return true;
        else return false;
    }
    public int smallestNumber(int n, int t) {
        int ans=0;
        for(int i=n; ;i++){
            if(isAns(i,t)){
               return i;
            }
        }
    }
}
