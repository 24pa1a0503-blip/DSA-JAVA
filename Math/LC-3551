class Solution {
    static int digSum(int n){
        int s=0;
        while(n>0){
            s+=n%10;
            n=n/10;
        }
        return s;
    }
    public int minSwaps(int[] nums) {
        int n=nums.length;
        int[][] arr=new int[n][2];
        for(int i=0;i<n;i++){
            arr[i][0]=nums[i];
            arr[i][1]=i;
        }
        Arrays.sort(arr,(a,b)->{
            int sa=digSum(a[0]);
            int sb=digSum(b[0]);
            if(sa!=sb) return Integer.compare(sa,sb);
            if(a[0]!=b[0]) return Integer.compare(a[0],b[0]);
            return Integer.compare(a[1],b[1]);
        });
        boolean[] visit=new boolean[n];
        int c=0;
        for(int i=0;i<n;i++){
            if(!visit[i]){
                int j=i;
                while(!visit[j]){
                    visit[j]=true;
                    j=arr[j][1];
                }
                c++;
            }
        }
        return n-c;
    }
}
