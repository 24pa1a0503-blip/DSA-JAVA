class Solution {
    public int numberOfSubarrays(int[] nums, int k) {
        return help(nums,k)-help(nums,k-1);
    }
    static int help(int[] nums,int k){
        if(k<0) return 0;
        int n=nums.length;
        int i=0;
        int c=0;
        int ans=0;
        for(int j=0;j<n;j++){
            if(nums[j]%2!=0) c++;
            while(c>k){
                if(nums[i]%2!=0) c--;
                i++;
            }
            ans+=(j-i+1);
        }
        return ans;
    }
}
