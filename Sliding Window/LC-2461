class Solution {
    public long maximumSubarraySum(int[] nums, int k) {
        long s=0;
        long max=0;
        HashMap<Integer,Integer> map=new HashMap<>();
        for(int i=0;i<nums.length;i++){
            s+=nums[i];
            map.put(nums[i],map.getOrDefault(nums[i],0)+1);
            if(i>=k){
                int out=nums[i-k];
                s-=out;
                map.put(out,map.get(out)-1);
                if(map.get(out)==0){
                    map.remove(out);
                }
            }
            if(i>=k-1 && map.size()==k){
                max=Math.max(max,s);
            }
        }
        return max;
    }
}
