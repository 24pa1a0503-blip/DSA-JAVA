class Solution {
    public int maxDepth(String s) {
        int max=0,c=0;
        for(int i=0;i<s.length();i++){
            char ch=s.charAt(i);
            if(ch=='(') c++;
            else if(ch==')') c--;
            else continue;
            max=Math.max(max,c);
        }
        return max;
    }
}
