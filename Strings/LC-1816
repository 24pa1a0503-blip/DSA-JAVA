class Solution {
    public String truncateSentence(String s, int k) {
        int sc=0;
        for(int i=0;i<s.length();i++){
            if(s.charAt(i)==' '){
                sc++;
                if(sc==k){
                    return s.substring(0,i);
                }
            }
        }
        return s;
    }
}
