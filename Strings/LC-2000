class Solution {
    public String reversePrefix(String word, char ch) {
        int n=word.length();
        int l=0,r=0;
        for(int j=0;j<n;j++){
            char x=word.charAt(j);
            if(x==ch){
                r=j;
                break;
            }
        }
        StringBuilder sb=new StringBuilder(word);
        while(l<=r){
            char temp=sb.charAt(l);
            sb.setCharAt(l,sb.charAt(r));
            sb.setCharAt(r,temp);
            l++;
            r--;
        }
        String res="";
        for(int i=0;i<sb.length();i++){
            res+=sb.charAt(i);
        }
        return res;
    }
}
