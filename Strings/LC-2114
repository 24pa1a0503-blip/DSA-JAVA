class Solution {
    public int mostWordsFound(String[] sentences) {
        int n=sentences.length;
        int ans=0;
        for(int i=0;i<n;i++){
            String s=sentences[i];
            String[] words=s.trim().split("\\s+");
            int c=words.length;
            ans=Math.max(ans,c);
        }
        return ans;
    }
}
