class Solution {
    public boolean checkString(String s) {
        int n=s.length();
        int in=n;
        for(int i=0;i<n;i++){
            if(s.charAt(i)!='a'){
                in=i;
                break;
            }
        }
        for(int j=in;j<n;j++){
            if(s.charAt(j)=='a') return false;
        }
        return true;
    }
}
