class Solution {
    public boolean digitCount(String num) {
        int n=num.length();
        int[] c=new int[10];
        for(int i=0;i<n;i++){
            int val=num.charAt(i)-'0';
            c[val]++;
        }
        for(int i=0;i<n;i++){
            int exc=num.charAt(i)-'0';
            if(c[i]!=exc) return false;
        }
        return true;
    }
}
