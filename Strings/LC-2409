class Solution {
    static int[] daysInMonth={31,28,31,30,31,30,31,31,30,31,30,31};
    static int convertToDayOfYear(String da){
        int m=Integer.parseInt(da.substring(0,2));
        int d=Integer.parseInt(da.substring(3,5));
        int doy=0;
        for(int i=0;i<m-1;i++) doy+=daysInMonth[i];
        doy+=d;
        return doy;
    }
    public int countDaysTogether(String arriveAlice, String leaveAlice, String arriveBob, String leaveBob) {
        int aa=convertToDayOfYear(arriveAlice);
        int la=convertToDayOfYear(leaveAlice);
        int ab=convertToDayOfYear(arriveBob);
        int lb=convertToDayOfYear(leaveBob);
        int s=Math.max(aa,ab);
        int e=Math.min(la,lb);
        if(s<=e) return e-s+1;
        return 0;
    }
}
