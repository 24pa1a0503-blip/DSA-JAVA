class Solution {
    static String help(char[] arr){
        int n=arr.length;
        int i=0;
        int j=n-1;
        while(i<j){
            while(i<j && Character.isLetter(arr[i])) i++;
            while(i<j && Character.isLetter(arr[j])) j--;
            char temp=arr[i];
            arr[i]=arr[j];
            arr[j]=temp;
            i++;
            j--;
        }
        return new String(arr);
    }
    public String reverseByType(String s) {
        char[] arr=s.toCharArray();
        int n=arr.length;
        int i=0;
        int j=n-1;
        while(i<j){
            while(i<j && !Character.isLetter(arr[i])) i++;
            while(i<j && !Character.isLetter(arr[j])) j--;
            char temp=arr[i];
            arr[i]=arr[j];
            arr[j]=temp;
            i++;
            j--;
        }
        String str = help(arr);
        return str;
    }
}
