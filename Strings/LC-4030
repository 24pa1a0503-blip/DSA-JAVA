class Solution {
    static boolean check(String p){
        int i=0,j=p.length()-1;
        while(i<j){
            if(p.charAt(i)!=p.charAt(j)) return false;
            i++;
            j--;
        }
        return true;
    }
    public boolean isPalindromic(String s) {
        StringBuilder binres=new StringBuilder();
        for(int i=0;i<s.length();i++){
            char ch=s.charAt(i);
            String bin=Integer.toBinaryString(ch);
            while(bin.length()<8){
                bin="0"+bin;
            }
            binres.append(bin);
        }
        String ps=binres.toString();
        return check(ps);
    }
}
