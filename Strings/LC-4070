class Solution {
    public int minRotations(String s) {
        int tot=0;
        int curr=0;
        for(int i=0;i<s.length();i++){
            int tar=s.charAt(i)-'0';
            int dif=Math.abs(tar-curr);
            tot+=Math.min(dif,10-dif);
            curr=tar;
        }
        return tot;
    }
}
