class Solution {
    public int lengthOfLastWord(String s) {
        int c=0;
        int j=s.length()-1;
        while(s.charAt(j)==' '){
            j--;
        }
        for(int i=j;i>=0;i--){
            char ch=s.charAt(i);
            if(ch!=' ') c++;
            else break;
        }
        return c;
    }
}
