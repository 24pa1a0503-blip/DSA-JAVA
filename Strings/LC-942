class Solution {
    public int[] diStringMatch(String s) {
        int d=s.length();
        int x=0;
        int n=s.length();
        int[] ans=new int[n+1];
        for(int i=0;i<n;i++){
            if(s.charAt(i)=='D'){
                ans[i]=d;
                d--;
            }
            else if(s.charAt(i)=='I'){
                ans[i]=x;
                x++;
            }
        }
        ans[n]=d;
        return ans;
    }
}
