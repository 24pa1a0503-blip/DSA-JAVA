class Solution {
    public void rotate(int[] nums, int k) {
        int n=nums.length;
        k=k%n;
        rotateAr(nums,0,n-1);
        rotateAr(nums,0,k-1);
        rotateAr(nums,k,n-1);
    }
    static int[] rotateAr(int[] nums,int l,int r){
        while(l<=r){
            int temp=nums[l];
            nums[l]=nums[r];
            nums[r]=temp;
            l++;
            r--;
        }
        return nums;
    }
}
