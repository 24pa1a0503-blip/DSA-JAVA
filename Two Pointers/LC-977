class Solution {
    public int[] sortedSquares(int[] nums) {
        int n=nums.length;
        int[] res=new int[n];
        int i=0;
        int j=n-1;
        int pos=n-1;
        while(i<=j){
            int ls=nums[i]*nums[i];
            int rs=nums[j]*nums[j];
            if(ls>rs){
                res[pos--]=ls;
                i++;
            }
            else{
                res[pos--]=rs;
                j--;
            }
        }
        return res;
    }
}
